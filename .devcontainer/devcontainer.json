{
  "name": "Whale Watch LHR",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "waitFor": "postCreateCommand",
  "postCreateCommand": "npm install && npm run build",
  "postAttachCommand": "bash -lc 'if curl -sf --max-time 2 http://localhost:8787/api/health >/dev/null 2>&1; then echo \"Whale Watch is already running on port 8787.\"; else npm start; fi'",
  "forwardPorts": [8787, 5173],
  "portsAttributes": {
    "8787": {
      "label": "Whale Watch LHR",
      "onAutoForward": "openPreview"
    },
    "5173": {
      "label": "Vite dev server",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"],
      "settings": {
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
